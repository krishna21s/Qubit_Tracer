    result = optimize_and_compare(qc, level)
    
    # Convert optimized circuit back to gate JSON
    optimized_gates = circuit_to_gate_json(qasm2_loads(result["optimized_qasm"]))
    
    return {
        "success": True,
        "original_stats": result["original"],
        "optimized_stats": result["optimized"],
        "improvements": result["improvements"],
        "optimized_gates": optimized_gates,
        "optimized_qubits": num_qubits,
    }
```

