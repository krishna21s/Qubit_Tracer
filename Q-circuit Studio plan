@app.post("/circuit/ai-generate")
async def circuit_ai_generate(data: dict = Body(None)):
    """
    Use Gemini to generate a quantum circuit from natural language.
    Returns circuit JSON that can be directly imported to canvas.
    """
    prompt = data.get("prompt", "")
    current_circuit = data.get("current_circuit", None)
    
    system_prompt = """You are a quantum circuit designer. Given a user's request,
    generate a quantum circuit as a JSON object with this exact format:
    {
      "qubits": <number>,
      "gates": [
        { "type": "<gate>", "qubits": [<indices>], "col": <time_step>, "params": {} }
      ],
      "explanation": "<brief explanation of the circuit>"
    }
    
    Available gates: H, X, Y, Z, S, T, Rx, Ry, Rz, U, CNOT, CZ, SWAP, CCX,
    MEASURE, BARRIER, RESET.
    Parametric gates (Rx, Ry, Rz) need params: { "theta": <radians> }.
    U gate needs: { "theta": <>, "phi": <>, "lambda": <> }.
    CNOT: qubits[0] = control, qubits[1] = target.
    Place gates at increasing col values for sequential operations.
    """
    
    response = gemini_client.models.generate_content(
        model="gemini-2.0-flash-exp",
        contents=[system_prompt, prompt],
    )
    
    # Parse JSON from response, validate, return
    circuit_json = extract_json(response.text)
    return { "success": True, **circuit_json }
