#### [NEW] `frontend/src/utils/circuitToQasm.js` — Client-Side QASM Generation

Convert circuit state to OpenQASM 2.0 string. This runs in the browser for instant code sync (no backend roundtrip for the read-only code panel).

```javascript
export function circuitToQasm(state) {
  let qasm = `OPENQASM 2.0;\ninclude "qelib1.inc";\n`;
  qasm += `qreg q[${state.qubits}];\ncreg c[${state.qubits}];\n\n`;
  
  // Sort gates by column (time step), then by qubit
  const sorted = [...state.gates].sort((a, b) => a.col - b.col || a.qubits[0] - b.qubits[0]);
  
  for (const gate of sorted) {
    // Map each gate to QASM instruction
    switch (gate.type) {
      case "H": qasm += `h q[${gate.qubits[0]}];\n`; break;
      case "CNOT": qasm += `cx q[${gate.qubits[0]}],q[${gate.qubits[1]}];\n`; break;
      case "Rz": qasm += `rz(${gate.params.theta}) q[${gate.qubits[0]}];\n`; break;
      case "MEASURE": qasm += `measure q[${gate.qubits[0]}] -> c[${gate.qubits[0]}];\n`; break;
      case "BARRIER": qasm += `barrier ${gate.qubits.map(q => `q[${q}]`).join(",")};\n`; break;
      // ... all other gates
    }
  }
  return qasm;
}
```

