#### `POST /circuit/simulate` — Simulate circuit from JSON

```python
@app.post("/circuit/simulate")
async def circuit_simulate(data: dict = Body(None)):
    """
    Accept circuit JSON (gates + qubits), build QuantumCircuit,
    simulate, return full results (bloch, counts, qasm, profile).
    """
    gates = data.get("gates", [])
    num_qubits = data.get("qubits", 1)
    
    qc = QuantumCircuit(num_qubits, num_qubits)
    
    # Sort gates by time step (col), apply in order
    for gate in sorted(gates, key=lambda g: g["col"]):
        apply_gate(qc, gate)  # Maps JSON gate → qc.h(), qc.cx(), etc.
    
    result = simulate_and_get_bloch(qc)
    profile = profile_circuit(qc)
    
    return {
        "success": True,
        **result,
        "circuit_profile": profile,
        "qiskit_code": generate_qiskit_code(gates, num_qubits),
    }
```

